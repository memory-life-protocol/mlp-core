# MLP Core — Environment Variables

# Environment
MLP_ENV=development

# Anthropic API key — required in production
ANTHROPIC_API_KEY=your_key_here

# FalkorDB — required in production
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# FalkorDB password — only if password protected
# Leave empty if no password set
FALKORDB_PASSWORD=

# Transport mode
# stdio: for local Claude Code and Cursor (default)
# http: for Railway deployment and web-based tools
MLP_TRANSPORT=http

# Port — used by HTTP transport and Railway health checks
PORT=8080

# Health check port — used by stdio transport only
HEALTH_PORT=3000
